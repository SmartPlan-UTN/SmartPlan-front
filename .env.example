# Plantilla de variables de entorno de SmartPlan Front.
# Copiala a `.env.local` para desarrollo local (está en .gitignore y no se commitea).

# URL base de la API de SmartPlan (Backend NestJS).
# En desarrollo local por defecto corre en el puerto 3001 con prefijo global /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
