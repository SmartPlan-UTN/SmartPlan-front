# Plantilla de variables de entorno de SmartPlan Front.
# Copiala a `.env.local` para desarrollo local (está en .gitignore y no se commitea).

# URL base de la API de SmartPlan (Backend NestJS).
# En desarrollo local por defecto corre en el puerto 3001 con prefijo global /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional. Link previews (WhatsApp) use the address each page was opened on,
# so localhost, a tunnel, staging and production need nothing here. Set it
# only if a proxy in front of the app hides the real domain, e.g.
# SITE_URL=https://staging.smartplan.com
SITE_URL=

# Google Maps JavaScript API key, for the activity map view (CU16).
# Needs a browser key from a project with the "Maps JavaScript API" enabled:
# https://console.cloud.google.com/google/maps-apis/credentials
# Without it, /explore/map shows an error state instead of a blank map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Mr world wide
